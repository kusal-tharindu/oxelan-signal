---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getRegularPosts } from '../lib/posts';

const posts = (await getRegularPosts()).slice(0, 5);
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for moved or never existed."
  noindex
>
  <header class="section-header" style="--section-color: var(--brand)">
    <div class="container-wide">
      <p class="section-label">Error 404</p>
      <h1 class="section-title mt-3">
        Signal <em class="accent">lost.</em>
      </h1>
      <p class="measure mt-5 text-base leading-relaxed text-muted-strong md:text-lg">
        That page moved or never existed. Search the archive, or pick up one of the latest briefings
        below.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
        <button type="button" class="btn btn-primary btn-lg" data-search-open>
          <Icon name="search" size={16} /> Search the archive
        </button>
        <a href="/" class="link-arrow">
          Back to the front page <Icon name="arrowRight" size={15} />
        </a>
      </div>
    </div>
  </header>

  <section class="container-wide pt-12" aria-labelledby="latest-posts-title">
    <h2 id="latest-posts-title" class="kicker mb-2">
      Latest posts
    </h2>
    <div class="divide-y divide-line">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
