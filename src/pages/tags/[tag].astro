---
import type { GetStaticPaths } from 'astro';
import TagListing from '../../components/TagListing.astro';
import { getAllPosts, postsForTag, getLatestDigest } from '../../lib/posts';
import { nextArchiveHref, pageCount, pageSlice } from '../../lib/pagination';
import { MIN_INDEXED_TAG_POSTS } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const allPosts = await getAllPosts();
const tagged = postsForTag(allPosts, tag);
const pages = pageCount(tagged.length);
const posts = pageSlice(tagged, 1);
const digest = getLatestDigest(allPosts);
// Thin tag pages stay for navigation but are kept out of the index and sitemap.
const thin = tagged.length < MIN_INDEXED_TAG_POSTS;
const olderHref = nextArchiveHref(1, tagged.length, `/tags/${tag}/`);
---

<TagListing
  tag={tag}
  posts={posts}
  allPosts={allPosts}
  digest={digest}
  page={1}
  pages={pages}
  total={tagged.length}
  olderHref={olderHref}
  thin={thin}
  noindex={thin}
/>
