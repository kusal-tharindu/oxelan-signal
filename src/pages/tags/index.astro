---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTags, getAllPosts } from '../../lib/posts';
import Icon from '../../components/Icon.astro';

const posts = await getAllPosts();
const tags = allTags(posts);
const max = Math.max(...tags.map((tag) => tag.count), 1);
---

<BaseLayout title="Tags" description="Browse every topic covered on Oxelan Signal.">
  <header class="section-header" style="--section-color: var(--brand)">
    <div class="container-wide">
      <p class="section-label">Index</p>
      <h1 class="section-title mt-2">Tags</h1>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
        Specific models, vulnerabilities, tools and practices. Tags cut across sections, so a
        Kubernetes security post appears in both Security and Engineering.
      </p>
    </div>
  </header>

  <section class="container-wide pt-8">
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {tags.map(({ tag, count }) => (
        <a
          href={`/tags/${tag}/`}
          class="group flex items-center justify-between gap-4 rounded border border-line bg-surface/60 px-4 py-3 transition-colors hover:border-brand/50 hover:bg-surface-2"
        >
          <span class="flex items-center gap-2">
            <Icon name="tag" size={13} class="text-muted" />
            <span class="font-label text-sm text-muted-strong group-hover:text-brand">#{tag}</span>
          </span>
          <span class="flex items-center gap-2">
            <span
              class="h-1 rounded-full bg-brand/70"
              style={`width: ${Math.max(8, (count / max) * 48)}px`}
              aria-hidden="true"
            ></span>
            <span class="w-5 text-right text-[0.68rem] text-muted">{count}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
