---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlertStrip from '../components/AlertStrip.astro';
import FilterBar from '../components/FilterBar.astro';
import PostFeed from '../components/PostFeed.astro';
import Sidebar from '../components/Sidebar.astro';
import SectionBadge from '../components/SectionBadge.astro';
import FormatBadge from '../components/FormatBadge.astro';
import ImpactBadge from '../components/ImpactBadge.astro';
import Icon from '../components/Icon.astro';
import {
  formatDate,
  getAllPosts,
  getAlerts,
  getGuides,
  getLatestDigest,
  getLeadPost,
  hrefOf,
  isoDate,
  readingTime,
  sectionOf,
} from '../lib/posts';
import { latestContentDate } from '../lib/freshness';
import { FEED_PAGE_SIZE, nextArchiveHref, pageCount } from '../lib/pagination';
import { sections, site } from '../site.config';

const posts = await getAllPosts();
const alerts = getAlerts(posts, 3);
const activeAlerts = getAlerts(posts, Number.MAX_SAFE_INTEGER);
const latest = latestContentDate(posts);
const lead = getLeadPost(posts);
const digest = getLatestDigest(posts);
const guides = getGuides(posts, 3);
const feed = lead ? posts.filter((post) => post.id !== lead.id) : posts;
// Cap the server-rendered feed so the home HTML stays a fixed size; overflow lives on
// the static archive pages reached through the "Older posts" link (review BLOG-M12).
const visibleFeed = feed.slice(0, FEED_PAGE_SIZE);
const olderHref = nextArchiveHref(1, feed.length, '/');
const leadSection = lead ? sections[sectionOf(lead)] : undefined;

const guidesHeading = 'Guides that stay current';
---

<BaseLayout description={site.description}>
  <AlertStrip alerts={alerts} total={activeAlerts.length} />

  <section class="container-wide pt-6 md:pt-9">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3 border-b border-line pb-4">
      <div>
        <p class="eyebrow">The briefing</p>
        <h1 class="mt-1 font-display text-[1.9rem] leading-[1.05] text-fg sm:text-3xl md:text-4xl">
          Signal over noise.
        </h1>
      </div>
      <div class="max-w-md md:text-right">
        <p class="text-[0.8125rem] leading-relaxed text-muted sm:text-sm">
          What changed in AI, security and engineering. Why it matters in production. What to do
          next.
        </p>
        <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] text-muted md:justify-end">
          {latest && <span>Updated {formatDate(latest)}</span>}
          <span aria-hidden="true">·</span>
          <span>{posts.length} posts</span>
          <span aria-hidden="true">·</span>
          <span>
            {activeAlerts.length}
            {activeAlerts.length === 1 ? ' advisory' : ' advisories'}
          </span>
          {digest && (
            <>
              <span aria-hidden="true">·</span>
              <a href={hrefOf(digest)} class="inline-flex items-center gap-1 hover:text-brand">
                Latest digest <Icon name="arrowRight" size={11} />
              </a>
            </>
          )}
        </p>
      </div>
    </div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        {lead && leadSection && (
          <article class="lead-banner" style={`--section-color: var(${leadSection.cssVar})`}>
            <div class="lead-banner-inner">
              <div class="lead-kicker">
                <SectionBadge section={leadSection.key} />
                <FormatBadge format={lead.data.format} />
                {lead.data.impact && <ImpactBadge impact={lead.data.impact} />}
                {lead.data.status === 'evolving' && (
                  <span class="inline-flex items-center gap-1.5 text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-medium">
                    <span class="dot animate-pulse" aria-hidden="true"></span> Evolving
                  </span>
                )}
              </div>

              <a href={hrefOf(lead)} class="group block">
                <h2 class="lead-title group-hover:text-brand">{lead.data.title}</h2>
              </a>

              <p class="lead-summary">{lead.data.summary}</p>

              <div class="post-meta">
                <time datetime={isoDate(lead.data.date)}>{formatDate(lead.data.date)}</time>
                <span>{readingTime(lead.body)} min read</span>
                <span>{leadSection.label}</span>
              </div>

              <div>
                <a href={hrefOf(lead)} class="btn btn-primary">
                  Read the briefing <Icon name="arrowRight" size={14} />
                </a>
              </div>
            </div>
          </article>
        )}

        <section class="mt-8" aria-labelledby="latest-title">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="eyebrow">Latest</p>
              <h2 id="latest-title" class="mt-1 font-display text-3xl leading-none text-fg">
                The feed
              </h2>
            </div>
            <span class="text-[0.75rem] text-muted">Newest first · all sections</span>
          </div>

          <div class="mt-4 border-y border-line py-3">
            <FilterBar />
          </div>

          <div class="mt-1">
            <PostFeed
              posts={visibleFeed}
              olderHref={olderHref}
              page={1}
              pages={pageCount(feed.length)}
            />
          </div>
        </section>

        {guides.length > 0 && (
          <section class="mt-12" aria-labelledby="guides-title">
            <div class="mb-4 flex flex-wrap items-end justify-between gap-3 border-b border-line pb-3">
              <div>
                <p class="eyebrow">Reference</p>
                <h2 id="guides-title" class="mt-1 font-display text-3xl leading-none text-fg">
                  {guidesHeading}
                </h2>
              </div>
              <a
                href="/engineering/"
                class="inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline"
              >
                View all <Icon name="arrowRight" size={12} />
              </a>
            </div>
            <div
              class:list={[
                'grid gap-px overflow-hidden border border-line bg-line',
                guides.length >= 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2',
              ]}
            >
              {guides.map((post) => {
                const section = sections[sectionOf(post)];
                return (
                  <a
                    href={hrefOf(post)}
                    class="group grid gap-2 bg-surface p-4 transition-colors hover:bg-surface-2"
                    style={`--section-color: var(${section.cssVar})`}
                  >
                    <div class="flex items-center gap-2">
                      <SectionBadge section={section.key} link={false} />
                      <FormatBadge format={post.data.format} />
                    </div>
                    <h3 class="font-display text-2xl leading-tight group-hover:text-brand">
                      {post.data.title}
                    </h3>
                    <p class="text-xs leading-relaxed text-muted">{post.data.summary}</p>
                    <span class="mt-auto pt-2 text-[0.75rem] text-muted">
                      Updated {formatDate(post.data.updated ?? post.data.date)}
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <div class="mt-10 flex flex-wrap items-center justify-between gap-4 rounded border border-line bg-surface/60 px-4 py-3">
          <p class="text-sm text-muted-strong">
            <span class="font-semibold text-fg">Every post answers three questions.</span>
            What changed, why it matters, and what to do.
          </p>
          <a href="/about/" class="btn btn-ghost !min-h-0 !py-2 !text-[0.75rem]">
            Editorial rules <Icon name="arrowUpRight" size={12} />
          </a>
        </div>
      </div>

      <div class="lg:sticky lg:top-24 lg:self-start">
        <Sidebar posts={posts} digest={digest} />
      </div>
    </div>
  </section>
</BaseLayout>
