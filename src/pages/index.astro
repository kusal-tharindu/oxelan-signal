---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlertStrip from '../components/AlertStrip.astro';
import SignalField from '../components/SignalField.astro';
import FilterBar from '../components/FilterBar.astro';
import PostFeed from '../components/PostFeed.astro';
import Sidebar from '../components/Sidebar.astro';
import SectionBadge from '../components/SectionBadge.astro';
import FormatBadge from '../components/FormatBadge.astro';
import ImpactBadge from '../components/ImpactBadge.astro';
import Icon from '../components/Icon.astro';
import {
  formatDate,
  getAllPosts,
  getAlerts,
  getGuides,
  getLatestDigest,
  getLeadPost,
  hrefOf,
  isoDate,
  readingTime,
  sectionOf,
} from '../lib/posts';
import { latestContentDate } from '../lib/freshness';
import { FEED_PAGE_SIZE, nextArchiveHref, pageCount } from '../lib/pagination';
import { sections, site, type SectionKey } from '../site.config';

const posts = await getAllPosts();
const alerts = getAlerts(posts, 3);
const activeAlerts = getAlerts(posts, Number.MAX_SAFE_INTEGER);
const latest = latestContentDate(posts);
const lead = getLeadPost(posts);
const digest = getLatestDigest(posts);
const guides = getGuides(posts, 3);
const feed = lead ? posts.filter((post) => post.id !== lead.id) : posts;
// Cap the server-rendered feed so the home HTML stays a fixed size; overflow lives on
// the static archive pages reached through the "Older posts" link (review BLOG-M12).
const visibleFeed = feed.slice(0, FEED_PAGE_SIZE);
const olderHref = nextArchiveHref(1, feed.length, '/');
const leadSection = lead ? sections[sectionOf(lead)] : undefined;

// Hero console: the lead story drawn as a briefing, with a log of what needs attention
// behind it. Both are built from frontmatter, so the hero is always real and current.
const leadRows = lead?.data.briefing
  ? [
      { num: '01', label: 'What changed', value: lead.data.briefing.changed },
      { num: '02', label: 'Why it matters', value: lead.data.briefing.why },
      { num: '03', label: 'What to do', value: lead.data.briefing.action },
    ]
  : [];

// The three desks. Copy is deliberately short; the section page carries the detail.
const deskOrder: { key: SectionKey; icon: string; blurb: string }[] = [
  {
    key: 'ai',
    icon: 'cpu',
    blurb: 'Models, agents and what they really cost once they leave the demo.',
  },
  {
    key: 'security',
    icon: 'shield',
    blurb: 'Incidents, CVEs and supply chain risk. Facts first, then the fix.',
  },
  {
    key: 'engineering',
    icon: 'terminal',
    blurb: 'Platforms, pipelines and the tradeoffs behind systems that stay up.',
  },
];
const desks = deskOrder.map((desk) => {
  const sectionPosts = posts.filter((post) => sectionOf(post) === desk.key);
  return { ...desk, section: sections[desk.key], count: sectionPosts.length, top: sectionPosts[0] };
});

const method = [
  {
    num: '01',
    title: 'What changed',
    body: 'The facts first, with the sources linked so you can check them yourself.',
  },
  {
    num: '02',
    title: 'Why it matters',
    body: 'What it means for systems running in production, not for a slide deck.',
  },
  {
    num: '03',
    title: 'What to do',
    body: 'One clear next step. Patch it, review it, or rest easy and move on.',
  },
];
---

<BaseLayout description={site.description} bodyClass="home">
  <AlertStrip alerts={alerts} total={activeAlerts.length} />

  <!-- ===================================================================== Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-field" aria-hidden="true"></div>

    <div class="container-wide hero-grid">
      <div class="hero-copy">
        <p class="kicker">
          <span>
            Independent briefings<span class="hidden sm:inline"> · AI, security, engineering</span>
          </span>
        </p>

        <h1 id="hero-title" class="hero-title">
          <span class="block">Something changed.</span>
          <span class="block">
            Here’s <em class="accent">what to do.</em>
          </span>
        </h1>

        <p class="hero-lede">
          Calm, sourced briefings for people who ship AI and keep it safe. Every story tells you
          what changed, why it matters in production and the next step to take.
        </p>

        <div class="hero-actions">
          {lead && (
            <a href={hrefOf(lead)} class="btn btn-primary btn-lg">
              Read the lead story <Icon name="arrowRight" size={16} />
            </a>
          )}
          <a href="/advisories/" class="link-arrow">
            See what needs patching <Icon name="arrowRight" size={15} />
          </a>
        </div>

        <p class="hero-live">
          <span class="live-dot" aria-hidden="true"></span>
          {latest && <span>Updated {formatDate(latest)}</span>}
          <span aria-hidden="true">/</span>
          <span>{posts.length} posts</span>
          <span aria-hidden="true">/</span>
          <span>
            {activeAlerts.length}
            {activeAlerts.length === 1 ? ' advisory' : ' advisories'}
          </span>
        </p>
      </div>

      {lead && leadSection && (
        <div class="hero-visual">
          <SignalField posts={posts} alerts={activeAlerts} lead={lead} />

          <article
            class="console console-front"
            style={`--section-color: var(${leadSection.cssVar})`}
          >
            <div class="console-bar">
              <span class="console-lights">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span class="console-path">
                <Icon name="link" size={11} />
                <span class="truncate">{`${site.domain}${hrefOf(lead)}`}</span>
              </span>
            </div>

            <div class="console-body">
              <div class="console-badges">
                <SectionBadge section={leadSection.key} link={false} />
                <FormatBadge format={lead.data.format} />
                {lead.data.impact && <ImpactBadge impact={lead.data.impact} />}
              </div>

              <h2 class="console-title">
                <a href={hrefOf(lead)} class="console-link">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {lead.data.title}
                </a>
              </h2>

              {leadRows.length > 0 ? (
                <dl class="console-rows">
                  {leadRows.map((row) => (
                    <div class="console-row">
                      <dt>
                        <span aria-hidden="true">{row.num}</span>
                        {row.label}
                      </dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="console-summary">{lead.data.summary}</p>
              )}
            </div>

            <div class="console-foot">
              <span>
                <time datetime={isoDate(lead.data.date)}>{formatDate(lead.data.date)}</time>
                <span aria-hidden="true"> · </span>
                {readingTime(lead.body)} min read
              </span>
              <span class="console-open">
                Open briefing <Icon name="arrowRight" size={13} />
              </span>
            </div>
          </article>
        </div>
      )}
    </div>
  </section>

  <!-- =================================================================== Method -->
  <section class="method reveal" aria-labelledby="method-title">
    <div class="container-wide">
      <div class="block-head">
        <p class="kicker">How every story works</p>
        <h2 id="method-title" class="h-section">
          Three questions. <em class="accent">Every time.</em>
        </h2>
      </div>
      <ol class="method-list">
        {method.map((step) => (
          <li class="method-step">
            <span class="method-num" aria-hidden="true">
              {step.num}
            </span>
            <h3 class="method-title">{step.title}</h3>
            <p class="method-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ==================================================================== Desks -->
  <section class="desks reveal" aria-labelledby="desks-title">
    <div class="container-wide">
      <div class="block-head block-head-split">
        <div>
          <p class="kicker">The desks</p>
          <h2 id="desks-title" class="h-section">
            Three beats. <em class="accent">One standard.</em>
          </h2>
        </div>
        <a href="/tags/" class="link-arrow">
          Browse every topic <Icon name="arrowRight" size={15} />
        </a>
      </div>

      <div class="desk-row">
        {desks.map((desk) => (
          <article class="desk" style={`--section-color: var(${desk.section.cssVar})`}>
            <div class="desk-top">
              <span class="desk-icon" aria-hidden="true">
                <Icon name={desk.icon} size={20} />
              </span>
              <span class="desk-count">
                {desk.count} {desk.count === 1 ? 'story' : 'stories'}
              </span>
            </div>
            <h3 class="desk-name">
              <a href={desk.section.path} class="desk-link">
                <span class="absolute inset-0" aria-hidden="true"></span>
                {desk.section.label}
              </a>
            </h3>
            <p class="desk-blurb">{desk.blurb}</p>
            {desk.top && (
              <p class="desk-latest">
                <span class="desk-latest-label">Latest</span>
                <span class="desk-latest-title">{desk.top.data.title}</span>
              </p>
            )}
            <span class="desk-cta" aria-hidden="true">
              Open the desk <Icon name="arrowRight" size={14} />
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =================================================================== Latest -->
  <section class="latest" aria-labelledby="latest-title">
    <div class="container-wide">
      <div class="block-head block-head-split">
        <div>
          <p class="kicker">Latest</p>
          <h2 id="latest-title" class="h-section">
            Everything we publish, <em class="accent">newest first.</em>
          </h2>
        </div>
        {digest && (
          <a href={hrefOf(digest)} class="link-arrow">
            Read this week’s digest <Icon name="arrowRight" size={15} />
          </a>
        )}
      </div>

      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0">
          <div class="latest-filters">
            <FilterBar />
          </div>
          <PostFeed
            posts={visibleFeed}
            olderHref={olderHref}
            page={1}
            pages={pageCount(feed.length)}
          />
        </div>

        <div class="lg:sticky lg:top-24 lg:self-start">
          <Sidebar posts={posts} digest={digest} showSubscribe={false} />
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== Guides -->
  {guides.length > 0 && (
    <section class="shelf reveal" aria-labelledby="guides-title">
      <div class="container-wide">
        <div class="block-head block-head-split">
          <div>
            <p class="kicker" style="--section-color: var(--eng)">
              Reference
            </p>
            <h2 id="guides-title" class="h-section">
              Guides that <em class="accent">stay current.</em>
            </h2>
          </div>
          <a href="/format/guide/" class="link-arrow">
            All guides <Icon name="arrowRight" size={15} />
          </a>
        </div>

        <ol class="shelf-list">
          {guides.map((post, index) => {
            const section = sections[sectionOf(post)];
            return (
              <li class="shelf-item" style={`--section-color: var(${section.cssVar})`}>
                <span class="shelf-num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="shelf-main">
                  <h3 class="shelf-title">
                    <a href={hrefOf(post)}>
                      <span class="absolute inset-0" aria-hidden="true"></span>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="shelf-summary">{post.data.summary}</p>
                </div>
                <div class="shelf-meta">
                  <SectionBadge section={section.key} link={false} />
                  <span>Reviewed {formatDate(post.data.updated ?? post.data.date)}</span>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )}

  <!-- ================================================================= Sign off -->
  <section class="signoff reveal" aria-labelledby="signoff-title">
    <div class="container-wide">
      <div class="signoff-inner">
        <div class="signoff-rings" aria-hidden="true">
          <span></span>
          <span></span>
        </div>
        <p class="kicker">Stay close to the signal</p>
        <h2 id="signoff-title" class="signoff-title">
          The next briefing is <em class="accent">already in the works.</em>
        </h2>
        <p class="signoff-body">
          Follow along by RSS. No account, no tracking and no algorithm deciding what you see.
        </p>
        <div class="signoff-actions">
          <a href="/rss.xml" class="btn btn-primary btn-lg">
            <Icon name="rss" size={16} /> Subscribe by RSS
          </a>
          <a href="/about/" class="link-arrow">
            Read our editorial rules <Icon name="arrowRight" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
