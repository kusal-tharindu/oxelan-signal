---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/FilterBar.astro';
import PostFeed from '../../components/PostFeed.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icon from '../../components/Icon.astro';
import { getAllPosts, getLatestDigest } from '../../lib/posts';
import { FEED_PAGE_SIZE, nextArchiveHref, pageCount } from '../../lib/pagination';
import { sectionOrder, sections, type SectionKey } from '../../site.config';

export const getStaticPaths = (() =>
  sectionOrder.map((section) => ({
    params: { section },
    props: { section },
  }))) satisfies GetStaticPaths;

interface Props {
  section: SectionKey;
}

const { section: sectionKey } = Astro.props;
const section = sections[sectionKey];
const allPosts = await getAllPosts();
const posts = allPosts.filter((post) => post.id.startsWith(`${sectionKey}/`));
const digest = getLatestDigest(allPosts);
const isDigest = sectionKey === 'digest';
const hasPosts = posts.length > 0;
// Cap the server-rendered feed; overflow lives on /<section>/page/2/ and beyond.
const visiblePosts = posts.slice(0, FEED_PAGE_SIZE);
const olderHref =
  pageCount(posts.length) > 1 ? nextArchiveHref(1, posts.length, section.path) : undefined;
---

<BaseLayout
  title={section.label}
  description={section.description}
  bodyClass={`section-${section.key}`}
>
  <header class="section-header" style={`--section-color: var(${section.cssVar})`}>
    <div class="container-wide">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="section-label">{section.label}</p>
          <h1 class="section-title mt-2">{section.label}</h1>
          <p class="measure mt-4 text-sm leading-relaxed text-muted-strong md:text-base">
            {section.description}
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 text-[0.75rem] text-muted md:items-end">
          <span>
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </span>
          <a
            href={`/${section.key}/rss.xml`}
            class="inline-flex items-center gap-1.5 hover:text-brand"
          >
            <Icon name="rss" size={12} /> Section RSS
          </a>
        </div>
      </div>
    </div>
  </header>

  <section class="container-wide pt-6">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        {hasPosts ? (
          <>
            <div class="border-b border-line pb-3">
              <FilterBar showSection={false} showFormat={!isDigest} showImpact={!isDigest} />
            </div>
            <PostFeed
              posts={visiblePosts}
              pageSize={12}
              sectionFilter={sectionKey}
              olderHref={olderHref}
            />
          </>
        ) : (
          <div class="empty-state">
            <p class="font-display text-2xl text-fg">This section opens soon.</p>
            <p class="mt-1 text-sm">
              The first post is being written. Subscribe to the RSS feed to catch it.
            </p>
          </div>
        )}
      </div>

      <div class="lg:sticky lg:top-24 lg:self-start">
        <Sidebar posts={allPosts} digest={digest} compact />
      </div>
    </div>
  </section>

  <section class="container-wide mt-14">
    <div class="rounded border border-line bg-surface/50 p-5">
      <p class="eyebrow">How this section works</p>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted">
        {isDigest
          ? 'Each digest is assembled from the week’s published posts and grouped by what needs attention first. Digests are generated as drafts, reviewed, then published.'
          : `Posts in ${section.label} are filed by their subject, not their format. A news item, an analysis and a guide can all live here. Use the format filter to narrow the view.`}
      </p>
      <p class="mt-3 flex flex-wrap gap-4 text-xs text-muted">
        <a href="/about/" class="inline-flex items-center gap-1 text-brand hover:underline">
          Editorial rules <Icon name="arrowUpRight" size={11} />
        </a>
        <a href="/rss.xml" class="inline-flex items-center gap-1 text-brand hover:underline">
          All posts RSS <Icon name="rss" size={11} />
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
