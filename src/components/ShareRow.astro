---
import Icon from './Icon.astro';

interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const xHref = `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
const liHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
// Shared base for the three controls: keep them compact but above the 24px tap-target floor.
const shareClass = 'btn btn-ghost !min-h-[1.5rem] !px-2 !py-1.5 !text-[0.75rem]';
---

<div class="share-row" role="group" aria-label="Share this post" data-pagefind-ignore>
  <a href={xHref} class={shareClass} rel="noopener" target="_blank">
    <Icon name="x" size={12} /> Share
  </a>
  <a href={liHref} class={shareClass} rel="noopener" target="_blank">
    <Icon name="linkedin" size={12} /> LinkedIn
  </a>
  <button type="button" class={shareClass} data-copy-link={url}>
    <span data-copy-icon="link">
      <Icon name="link" size={12} />
    </span>
    <span data-copy-icon="check" class="hidden">
      <Icon name="check" size={12} />
    </span>
    <span data-copy-label aria-live="polite">
      Copy link
    </span>
  </button>
</div>
