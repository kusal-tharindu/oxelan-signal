---
import type { Post } from '../lib/posts';
import { formatDate, hrefOf, isRecent, PATCH_MAX_AGE_DAYS, trendingTags } from '../lib/posts';
import Icon from './Icon.astro';
import ImpactBadge from './ImpactBadge.astro';
import { site } from '../site.config';

interface Props {
  posts: Post[];
  digest?: Post | undefined;
  compact?: boolean;
}

const { posts, digest, compact = false } = Astro.props;
const patchNow = posts
  .filter(
    (post) =>
      post.data.action === 'patch-now' &&
      post.data.status !== 'superseded' &&
      isRecent(post, PATCH_MAX_AGE_DAYS),
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, compact ? 3 : 5);
const tags = trendingTags(posts, compact ? 5 : 8);
---

<aside class="space-y-4" aria-label="Sidebar">
  <section class="sidebar-panel">
    <h2 class="panel-title">
      <span class="inline-flex items-center gap-1.5 text-high">
        <Icon name="wrench" size={13} /> Patch now
      </span>
      {patchNow.length > 0 && (
        <span class="text-[0.75rem] font-normal tracking-normal normal-case text-muted">
          {patchNow.length}
        </span>
      )}
    </h2>
    {patchNow.length > 0 ? (
      <ul class="space-y-2.5">
        {patchNow.map((post) => (
          <li class="grid gap-1">
            <div class="flex items-center gap-2">
              {post.data.impact && <ImpactBadge impact={post.data.impact} />}
              <span class="text-[0.75rem] text-muted">
                {formatDate(post.data.date, { month: 'short', day: 'numeric' })}
              </span>
            </div>
            <a
              href={hrefOf(post)}
              class="text-[0.84rem] font-medium leading-snug text-muted-strong hover:text-brand"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-xs leading-relaxed text-muted">
        No active patch advisories. That is a good week.
      </p>
    )}
    <a
      href="/security/"
      class="mt-3 inline-flex items-center gap-1 text-[0.75rem] font-semibold text-brand hover:underline"
    >
      All security posts <Icon name="arrowRight" size={11} />
    </a>
  </section>

  {digest && (
    <section class="sidebar-panel">
      <h2 class="panel-title">
        <span>This week’s digest</span>
        <Icon name="calendar" size={13} />
      </h2>
      <a href={hrefOf(digest)} class="group block">
        <p class="text-[0.75rem] text-muted">{formatDate(digest.data.date)}</p>
        <p class="mt-1 font-display text-xl leading-tight text-fg group-hover:text-brand">
          {digest.data.title}
        </p>
        <p class="mt-1.5 text-xs leading-relaxed text-muted">{digest.data.summary}</p>
      </a>
      <a
        href="/digest/"
        class="mt-3 inline-flex items-center gap-1 text-[0.75rem] font-semibold text-brand hover:underline"
      >
        All digests <Icon name="arrowRight" size={11} />
      </a>
    </section>
  )}

  <section class="sidebar-panel">
    <h2 class="panel-title">
      <span>Trending tags</span>
      <Icon name="tag" size={13} />
    </h2>
    <div class="flex flex-wrap gap-1.5">
      {tags.map(({ tag, count }) => (
        <a href={`/tags/${tag}/`} class="tag">
          {tag} <span class="ml-1 text-muted">{count}</span>
        </a>
      ))}
    </div>
  </section>

  <section
    class="sidebar-panel"
    style="border-color: color-mix(in srgb, var(--brand) 30%, var(--line))"
  >
    <h2 class="panel-title">
      <span class="text-brand">Stay updated</span>
      <Icon name="rss" size={13} />
    </h2>
    <p class="text-xs leading-relaxed text-muted">
      Follow the signal without an algorithm. One feed for every section, no tracking.
    </p>
    <div class="mt-3 flex flex-wrap gap-2">
      <a href="/rss.xml" class="btn btn-primary !min-h-0 !py-1.5 !text-[0.75rem]">
        <Icon name="rss" size={12} /> RSS feed
      </a>
      <a
        href={`${site.socials.github}/oxelan-signal`}
        class="btn !min-h-0 !py-1.5 !text-[0.75rem]"
        rel="noopener"
      >
        <Icon name="github" size={12} /> Source
      </a>
    </div>
  </section>
</aside>
