---
import type { Post } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const briefing = post.data.briefing;
const action = post.data.action;
const affects = post.data.affects ?? [];

const rows = briefing
  ? [
      { num: '01', label: 'What changed', value: briefing.changed },
      { num: '02', label: 'Why it matters', value: briefing.why },
      { num: '03', label: 'What to do', value: briefing.action },
    ]
  : [];
---

{briefing && (
  <aside class="briefing" aria-label="Briefing">
    <div class="briefing-bar">
      <h2 class="briefing-title">Briefing</h2>
      {post.data.status === 'evolving' ? (
        <span class="inline-flex items-center gap-1.5 font-mono text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-medium">
          <span class="dot animate-pulse" aria-hidden="true"></span> Evolving story
        </span>
      ) : (
        <span class="font-mono text-[0.75rem] uppercase tracking-[0.12em] text-muted">
          Three questions
        </span>
      )}
    </div>

    {rows.map((row) => (
      <div class="briefing-row">
        <span class="briefing-label">
          <span class="briefing-num" aria-hidden="true">
            {row.num}
          </span>
          {row.label}
        </span>
        <p class="briefing-value">{row.value}</p>
      </div>
    ))}

    {(action || affects.length > 0) && (
      <div class="briefing-foot">
        {action && (
          <span class="inline-flex items-center gap-1.5 font-semibold uppercase tracking-[0.08em]">
            <Icon
              name={action === 'patch-now' ? 'alert' : 'refresh'}
              size={13}
              class={action === 'patch-now' ? 'text-critical' : 'text-medium'}
            />
            <span class="text-muted">Action</span>
            <span
              class={
                action === 'patch-now'
                  ? 'text-critical'
                  : action === 'review'
                    ? 'text-medium'
                    : 'text-muted-strong'
              }
            >
              {action === 'patch-now' ? 'Patch now' : action === 'review' ? 'Review' : 'None'}
            </span>
          </span>
        )}
        {affects.length > 0 && (
          <span class="inline-flex flex-wrap items-center gap-1.5 text-muted-strong">
            <span class="font-semibold uppercase tracking-[0.08em] text-muted">Affects</span>
            {affects.map((item) => (
              <code class="rounded border border-line bg-surface-2 px-1.5 py-0.5 font-mono text-[0.75rem]">
                {item}
              </code>
            ))}
          </span>
        )}
      </div>
    )}
  </aside>
)}
