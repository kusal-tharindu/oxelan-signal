---
import type { Post } from '../lib/posts';
import { formatDate, isoDate, readingTime, sectionOf, hrefOf } from '../lib/posts';
import { sections } from '../site.config';
import SectionBadge from './SectionBadge.astro';
import FormatBadge from './FormatBadge.astro';
import ImpactBadge from './ImpactBadge.astro';

interface Props {
  post: Post;
  showSummary?: boolean;
  showTags?: boolean;
  headingLevel?: 'h2' | 'h3' | 'h4';
  compact?: boolean;
}

const {
  post,
  showSummary = true,
  showTags = false,
  headingLevel = 'h3',
  compact = false,
} = Astro.props;

const section = sections[sectionOf(post)];
const Heading = headingLevel;
const minutes = readingTime(post.body);
const isDraft = post.data.draft;
const isScheduled = post.data.date > new Date();
---

<article
  class="post-card group"
  data-post-card
  data-section={section.key}
  data-format={post.data.format}
  data-impact={post.data.impact ?? 'none'}
  data-tags={post.data.tags.join(' ')}
  data-date={isoDate(post.data.date)}
  style={`--section-color: var(${section.cssVar})`}
>
  <div class="flex flex-wrap items-center gap-2">
    <SectionBadge section={section.key} />
    <FormatBadge format={post.data.format} />
    {post.data.impact && <ImpactBadge impact={post.data.impact} />}
    {post.data.status === 'evolving' && (
      <span class="badge badge-format" style="color: var(--medium); border-color: var(--medium)">
        <span class="dot" style="background: var(--medium)" aria-hidden="true"></span> Evolving
      </span>
    )}
    {isDraft && <span class="badge badge-draft">Draft</span>}
    {isScheduled && !isDraft && <span class="badge badge-draft">Scheduled</span>}
  </div>

  <Heading class="post-card-title">
    <a href={hrefOf(post)}>
      <span class="absolute inset-0" aria-hidden="true"></span>
      {post.data.title}
    </a>
  </Heading>

  {showSummary && <p class="post-card-summary">{post.data.summary}</p>}

  <div class="post-meta">
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <span>{minutes} min read</span>
    {post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
    {!compact && <span>{section.label}</span>}
  </div>

  {showTags && (
    <div class="flex flex-wrap gap-1.5 pt-1">
      {post.data.tags.map((tag) => (
        <a href={`/tags/${tag}/`} class="tag">
          {tag}
        </a>
      ))}
    </div>
  )}
</article>
