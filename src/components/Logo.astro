---
import { site } from '../site.config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a href="/" class="group inline-flex items-center gap-2.5" aria-label={`${site.name} home`}>
  <svg
    width="30"
    height="30"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect
      x="4"
      y="4"
      width="24"
      height="24"
      transform="rotate(45 16 16)"
      stroke="var(--brand)"
      stroke-width="1.5"
    />
    <rect
      x="10"
      y="10"
      width="12"
      height="12"
      transform="rotate(45 16 16)"
      fill="var(--brand)"
      fill-opacity="0.12"
      stroke="var(--brand)"
      stroke-width="1"
    />
    <circle cx="16" cy="16" r="2.5" fill="var(--brand)" />
    <path
      d="M21.5 8.5a10 10 0 0 1 0 15"
      stroke="var(--brand)"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.55"
    />
  </svg>
  <span class:list={['display leading-none', compact ? 'text-[1.3rem]' : 'text-[1.5rem]']}>
    Oxelan <span class="text-brand">Signal</span>
  </span>
</a>
