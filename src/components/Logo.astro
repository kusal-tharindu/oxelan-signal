---
import { site } from '../site.config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<!--
  Wordmark mirrors oxelan.com headlines: "Oxelan" in bold Space Grotesk, "Signal" as the
  amber Instrument Serif italic accent.
-->
<a href="/" class="logo group" aria-label={`${site.name} home`}>
  <svg
    width="30"
    height="30"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="logo-mark shrink-0"
  >
    <rect
      x="4"
      y="4"
      width="24"
      height="24"
      transform="rotate(45 16 16)"
      stroke="var(--brand)"
      stroke-width="1.5"
    />
    <rect
      x="10"
      y="10"
      width="12"
      height="12"
      transform="rotate(45 16 16)"
      fill="var(--brand)"
      fill-opacity="0.12"
      stroke="var(--brand)"
      stroke-width="1"
    />
    <circle cx="16" cy="16" r="2.5" fill="var(--brand)" />
    <path
      class="logo-arc"
      d="M21.5 8.5a10 10 0 0 1 0 15"
      stroke="var(--brand)"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.55"
    ></path>
  </svg>
  <span class:list={['logo-word', compact ? 'text-[1.12rem]' : 'text-[1.35rem]']}>
    <span class="logo-oxelan">Oxelan</span>
    <span class="logo-signal">Signal</span>
  </span>
</a>
