---
import Icon from './Icon.astro';
---

<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title" data-search-dialog>
  <h2 id="search-title" class="sr-only">
    Search Oxelan Signal
  </h2>

  <div class="search-input-wrap">
    <Icon name="search" size={19} class="shrink-0 text-muted" />
    <input
      type="search"
      class="search-input"
      placeholder="Search posts, tags, tools…"
      autocomplete="off"
      spellcheck="false"
      aria-label="Search posts"
      data-search-input
    />
    <button type="button" class="icon-btn shrink-0" data-search-close aria-label="Close search">
      <Icon name="close" size={18} />
    </button>
  </div>

  <div class="search-results" data-search-results aria-live="polite">
    <div class="px-3 py-8 text-center text-sm text-muted">
      <p>Type to search the archive.</p>
      <p class="mt-1 text-xs">Search by title, tag, summary or body text.</p>
    </div>
  </div>

  <div class="search-footer">
    <span>
      <kbd>↑</kbd> <kbd>↓</kbd> navigate
    </span>
    <span>
      <kbd>Enter</kbd> open
    </span>
    <span>
      <kbd>Esc</kbd> close
    </span>
    <span class="ml-auto hidden sm:inline">Pagefind index · built at deploy</span>
  </div>
</dialog>
