---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { formatOrder, formats } from '../lib/formats';
import { site, sections } from '../site.config';
import { getAllPosts, trendingTags } from '../lib/posts';

const posts = await getAllPosts();
const tags = trendingTags(posts, 5);
const currentYear = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-statement">
      <p class="footer-line">
        Less noise. <em class="accent">More signal.</em>
      </p>
      <p class="footer-note">
        An independent publication from Oxelan, the engineering studio that builds things and then
        keeps them running.
      </p>
    </div>

    <div class="footer-grid">
      <div class="footer-brand">
        <Logo compact />
        <p class="mt-4 max-w-xs text-[0.875rem] leading-relaxed text-muted">{site.tagline}</p>
        <div class="mt-5 flex items-center gap-1">
          <a href={site.socials.github} class="icon-btn" aria-label="GitHub" rel="me noopener">
            <Icon name="github" size={17} />
          </a>
          <a href={site.socials.linkedin} class="icon-btn" aria-label="LinkedIn" rel="me noopener">
            <Icon name="linkedin" size={17} />
          </a>
          <a href={site.socials.x} class="icon-btn" aria-label="X" rel="me noopener">
            <Icon name="x" size={16} />
          </a>
        </div>
      </div>

      <div>
        <h2 class="footer-heading">Sections</h2>
        <ul class="footer-links">
          {Object.values(sections).map((section) => (
            <li>
              <a href={section.path}>{section.label}</a>
            </li>
          ))}
          <li>
            <a href="/advisories/">Advisories</a>
          </li>
          <li>
            <a href="/radar/">Radar</a>
          </li>
          <li>
            <a href="/about/">About</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Formats</h2>
        <ul class="footer-links">
          {formatOrder.map((key) => (
            <li>
              <a href={formats[key].path}>{formats[key].label}</a>
            </li>
          ))}
        </ul>

        <h2 class="footer-heading mt-8">Topics</h2>
        <ul class="footer-links">
          {tags.map(({ tag }) => (
            <li>
              <a href={`/tags/${tag}/`}>#{tag}</a>
            </li>
          ))}
          <li>
            <a href="/tags/">All tags</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Stay updated</h2>
        <ul class="footer-links">
          <li>
            <a href="/rss.xml" class="inline-flex items-center gap-2">
              <Icon name="rss" size={13} /> Everything
            </a>
          </li>
          <li>
            <a href="/security/rss.xml" class="inline-flex items-center gap-2">
              <Icon name="rss" size={13} /> Security
            </a>
          </li>
          <li>
            <a href="/ai/rss.xml" class="inline-flex items-center gap-2">
              <Icon name="rss" size={13} /> AI
            </a>
          </li>
        </ul>
        <p class="mt-5 max-w-[16rem] text-[0.8125rem] leading-relaxed text-muted">
          No tracking. No paywall. Every post lives in git, so every change is on the record.
        </p>
      </div>
    </div>

    <div class="footer-base">
      <p>
        © {currentYear} Oxelan · Content CC BY 4.0 · Code MIT ·
        <a href="/about/#disclaimer">Disclaimer</a>
      </p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href={site.socials.oxelan} class="inline-flex items-center gap-1" rel="noopener">
          oxelan.com <Icon name="arrowUpRight" size={11} />
        </a>
        <a
          href={`${site.socials.github}/oxelan-signal`}
          class="inline-flex items-center gap-1"
          rel="noopener"
        >
          Source on GitHub <Icon name="arrowUpRight" size={11} />
        </a>
      </p>
    </div>
  </div>
</footer>
