---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-nav" data-site-nav>
  <div class="container-wide flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <div class="flex items-center gap-10">
      <Logo compact />
      <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
        {site.nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        class="nav-search hidden sm:flex"
        data-search-open
        aria-label="Search posts"
      >
        <Icon name="search" size={15} />
        <span class="font-label text-[0.8125rem]">Search</span>
        <kbd class="ml-3">/</kbd>
      </button>
      <button type="button" class="icon-btn sm:hidden" data-search-open aria-label="Search posts">
        <Icon name="search" size={18} />
      </button>
      <ThemeToggle />
      <a href="/rss.xml" class="icon-btn hidden sm:grid" aria-label="RSS feed" title="RSS feed">
        <Icon name="rss" size={16} />
      </a>
      <button
        type="button"
        class="icon-btn lg:hidden"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span data-menu-icon="open">
          <Icon name="menu" size={20} />
        </span>
        <span data-menu-icon="close" class="hidden">
          <Icon name="close" size={20} />
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden lg:hidden" data-mobile-menu hidden>
    <nav class="container-wide py-3" aria-label="Mobile">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
          <Icon name="chevronRight" size={14} />
        </a>
      ))}
      <a href="/rss.xml">
        <span>RSS</span>
        <Icon name="rss" size={14} />
      </a>
    </nav>
  </div>
</header>
