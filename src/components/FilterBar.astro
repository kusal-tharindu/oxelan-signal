---
import { browseFormats, formats } from '../lib/formats';

interface Props {
  showFormat?: boolean;
  showImpact?: boolean;
  label?: string;
}

const { showFormat = true, showImpact = true, label = 'Browse posts' } = Astro.props;

const path = Astro.url.pathname;
const isFormatActive = (href: string) => path.startsWith(href);
---

<nav class="filter-bar" data-browse aria-label={label}>
  {showFormat && (
    <div class="filter-group" role="group" aria-label="Format">
      {browseFormats.map((key) => {
        const format = formats[key];
        return (
          <a
            href={format.path}
            class="chip"
            aria-current={isFormatActive(format.path) ? 'page' : undefined}
          >
            {format.label}
          </a>
        );
      })}
    </div>
  )}

  {showImpact && (
    <div class="filter-group" role="group" aria-label="Impact">
      <a
        href="/advisories/"
        class="chip"
        aria-current={path.startsWith('/advisories/') ? 'page' : undefined}
      >
        Critical + high
      </a>
    </div>
  )}
</nav>
