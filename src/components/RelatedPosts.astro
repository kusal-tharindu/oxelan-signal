---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section
    aria-labelledby="related-title"
    data-pagefind-ignore
    class="mt-14 border-t border-line pt-7"
  >
    <div class="mb-4 flex items-end justify-between gap-4">
      <h2 id="related-title" class="eyebrow">
        Related <span class="text-brand">reading</span>
      </h2>
      <span class="text-[0.75rem] text-muted">{posts.length} posts</span>
    </div>
    <div class="grid gap-x-8 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} showSummary={false} headingLevel="h3" />
      ))}
    </div>
  </section>
)}
