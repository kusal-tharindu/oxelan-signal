---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';

interface Props {
  posts: Post[];
  /** Link to the next (older) archive page. */
  olderHref?: string | undefined;
  /** Link to the previous (newer) archive page. */
  newerHref?: string | undefined;
  page?: number | undefined;
  pages?: number | undefined;
  emptyTitle?: string;
  emptyBody?: string;
}

const {
  posts,
  olderHref,
  newerHref,
  page,
  pages,
  emptyTitle = 'Nothing here yet.',
  emptyBody = 'Browse another section or the latest posts.',
} = Astro.props;

const showPager = Boolean(newerHref || olderHref);
---

<div>
  {posts.length > 0 ? (
    <div class="divide-y divide-line">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <p class="font-display text-2xl text-fg">{emptyTitle}</p>
      <p class="mt-1 text-sm">{emptyBody}</p>
    </div>
  )}

  {showPager && (
    <nav class="feed-pagination" aria-label="Pagination">
      {newerHref ? (
        <a href={newerHref} class="btn btn-ghost">
          <Icon name="arrowLeft" size={14} /> Newer
        </a>
      ) : (
        <span></span>
      )}

      {page && pages ? (
        <span class="feed-pagination-status">
          Page {page} of {pages}
        </span>
      ) : (
        <span></span>
      )}

      {olderHref ? (
        <a href={olderHref} class="btn btn-ghost">
          Older <Icon name="arrowRight" size={14} />
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  )}
</div>
