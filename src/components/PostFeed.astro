---
import type { Post } from '../lib/posts';
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';

interface Props {
  posts: Post[];
  pageSize?: number;
  sectionFilter?: string;
  emptyTitle?: string;
  emptyBody?: string;
  /** Link to the next static archive page, shown once the rendered window is exhausted. */
  olderHref?: string | undefined;
}

const {
  posts,
  pageSize = 10,
  sectionFilter = 'all',
  emptyTitle = 'Nothing matches those filters.',
  emptyBody = 'Try clearing one filter or browse the latest posts.',
  olderHref,
} = Astro.props;
---

<div data-filter-target data-section-filter={sectionFilter} data-page-size={pageSize}>
  <div class="divide-y divide-line" data-post-list>
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>

  <div class="empty-state" data-filter-empty hidden>
    <p class="font-display text-2xl text-fg">{emptyTitle}</p>
    <p class="mt-1 text-sm">{emptyBody}</p>
  </div>

  <div class="mt-6 flex flex-col items-center gap-3">
    <button type="button" class="btn" data-load-more hidden>
      Load older posts
    </button>
    {olderHref && (
      <a href={olderHref} class="btn btn-ghost">
        Older posts <Icon name="arrowRight" size={14} />
      </a>
    )}
  </div>
</div>
