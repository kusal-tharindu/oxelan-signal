---
import Icon from './Icon.astro';
import type { Post } from '../lib/posts';
import { hrefOf } from '../lib/posts';
import { sections } from '../site.config';

interface Props {
  newer?: Post | undefined;
  older?: Post | undefined;
  section: string;
}

const { newer, older, section } = Astro.props;
const sectionMeta = sections[section as keyof typeof sections];
---

{(newer || older) && (
  <nav
    data-pagefind-ignore
    class="mt-10 grid gap-px overflow-hidden rounded border border-line bg-line sm:grid-cols-2"
    aria-label={`More in ${sectionMeta?.label ?? section}`}
  >
    <div class="bg-surface p-4">
      {older ? (
        <a href={hrefOf(older)} class="group block">
          <span class="inline-flex items-center gap-1 text-[0.75rem] uppercase tracking-[0.1em] text-muted">
            <Icon name="arrowLeft" size={11} /> Previous in {sectionMeta?.label ?? section}
          </span>
          <span class="mt-1.5 block font-display text-xl leading-tight group-hover:text-brand">
            {older.data.title}
          </span>
        </a>
      ) : (
        <span class="text-xs text-muted">This is the first post in this section.</span>
      )}
    </div>
    <div class="bg-surface p-4 sm:text-right">
      {newer ? (
        <a href={hrefOf(newer)} class="group block">
          <span class="inline-flex items-center gap-1 text-[0.75rem] uppercase tracking-[0.1em] text-muted sm:justify-end">
            Next in {sectionMeta?.label ?? section} <Icon name="arrowRight" size={11} />
          </span>
          <span class="mt-1.5 block font-display text-xl leading-tight group-hover:text-brand">
            {newer.data.title}
          </span>
        </a>
      ) : (
        <span class="text-xs text-muted">You are reading the latest post in this section.</span>
      )}
    </div>
  </nav>
)}
