---
import type { Post } from '../lib/posts';
import {
  displayFormat,
  formatDate,
  hrefOf,
  initials,
  isoDate,
  isoDateTime,
  metaDescription,
  readingTime,
  sectionOf,
} from '../lib/posts';
import { site, sections } from '../site.config';
import BaseLayout from './BaseLayout.astro';
import type { Heading } from '../components/Toc.astro';
import Toc from '../components/Toc.astro';
import BriefingBox from '../components/BriefingBox.astro';
import ShareRow from '../components/ShareRow.astro';
import SectionBadge from '../components/SectionBadge.astro';
import FormatBadge from '../components/FormatBadge.astro';
import ImpactBadge from '../components/ImpactBadge.astro';
import Icon from '../components/Icon.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ArticleNav from '../components/ArticleNav.astro';
import Comments from '../components/Comments.astro';

interface Props {
  post: Post;
  headings: Heading[];
  related: Post[];
  newer?: Post | undefined;
  older?: Post | undefined;
}

const { post, headings, related, newer, older } = Astro.props;

const section = sections[sectionOf(post)];
const minutes = readingTime(post.body);
const canonical = new URL(hrefOf(post), site.url).toString();
const ogImage = `/og/${post.id}.png`;
const summary = post.data.summary;
const description = metaDescription(summary, post.data.description);
const modified = post.data.updated ?? post.data.date;
const isGuide = post.data.format === 'guide';
const isSuperseded = post.data.status === 'superseded';

const articleSchema = {
  '@type': 'Article',
  '@id': `${canonical}#article`,
  mainEntityOfPage: canonical,
  headline: post.data.title,
  description,
  datePublished: isoDateTime(post.data.date),
  dateModified: isoDateTime(modified),
  articleSection: section.label,
  keywords: post.data.tags.join(', '),
  image: [new URL(ogImage, site.url).toString()],
  author: {
    '@type': 'Person',
    name: site.author.name,
    url: site.author.url,
  },
  publisher: { '@id': `${site.url}/#organization` },
  isAccessibleForFree: true,
  inLanguage: site.language,
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={isoDateTime(post.data.date)}
  modifiedTime={isoDateTime(modified)}
  tags={post.data.tags}
  jsonLd={[articleSchema]}
  noindex={post.data.draft || post.data.date > new Date()}
  rssPath={`/${section.key}/rss.xml`}
  rssTitle={`${section.label} — Oxelan Signal`}
  bodyClass="article-page"
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <div class="page-glow" style={`--section-color: var(${section.cssVar})`} aria-hidden="true"></div>

  <div class="container-wide pt-6">
    <nav
      aria-label="Breadcrumb"
      class="flex min-w-0 items-center gap-1.5 text-[0.8125rem] text-muted"
    >
      <a href="/" class="shrink-0 hover:text-brand">
        Home
      </a>
      <Icon name="chevronRight" size={11} class="shrink-0" />
      <a href={section.path} class="shrink-0 hover:text-brand">
        {section.label}
      </a>
      {/* The current title is omitted below sm so a long headline cannot wrap 2-3 lines
          before the article starts. */}
      <span class="hidden min-w-0 items-center gap-1.5 sm:flex">
        <Icon name="chevronRight" size={11} class="shrink-0" />
        <span class="truncate text-muted-strong" aria-current="page">
          {post.data.title}
        </span>
      </span>
    </nav>
  </div>

  <article
    class="container-wide pb-8 pt-8 md:pt-12"
    data-article
    data-pagefind-body
    data-post-section={section.label}
  >
    <span data-pagefind-meta={`section:${section.label}`} aria-hidden="true"></span>
    <span data-pagefind-meta={`sectionKey:${section.key}`} aria-hidden="true"></span>
    {/* Facets for the search UI: the index is built from content, not a manual list. */}
    <span class="sr-only" data-pagefind-filter="section">
      {section.label}
    </span>
    <span class="sr-only" data-pagefind-filter="format">
      {displayFormat(post.data.format)}
    </span>
    {post.data.tags.map((tag) => (
      <span class="sr-only" data-pagefind-filter="tag">
        {tag}
      </span>
    ))}
    <div
      class="mb-5 flex flex-wrap items-center gap-2"
      style={`--section-color: var(${section.cssVar})`}
    >
      <SectionBadge section={section.key} />
      <FormatBadge format={post.data.format} />
      {post.data.impact && <ImpactBadge impact={post.data.impact} />}
      {post.data.status === 'evolving' && (
        <span class="inline-flex items-center gap-1.5 text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-medium">
          <span class="dot animate-pulse" aria-hidden="true"></span> Evolving story
        </span>
      )}
      {post.data.draft && <span class="badge badge-draft">Draft — local only</span>}
    </div>

    {/* On desktop the header spans exactly the reading column (the aside is 16rem plus
        the 2.5rem gap), so its rules line up with the briefing console below. */}
    <div class="max-w-4xl lg:max-w-none lg:pr-[18.5rem]">
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-lede mt-5">{summary}</p>

      <div
        class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-line py-3.5"
        data-pagefind-ignore
      >
        <span class="flex items-center gap-2.5 text-[0.875rem] font-medium text-fg">
          <span class="grid h-8 w-8 place-items-center rounded-full border border-brand/40 bg-brand-soft font-mono text-[0.75rem] font-semibold text-brand">
            {initials(site.author.name)}
          </span>
          {site.author.name}
        </span>
        <span class="post-meta">
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          <span>{minutes} min read</span>
          {post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
        </span>
        <div class="md:ml-auto md:border-l md:border-line md:pl-5">
          <ShareRow url={canonical} title={post.data.title} />
        </div>
      </div>
    </div>

    {isSuperseded && post.data.supersededBy && (
      <div class="mt-5 flex flex-wrap items-center gap-3 rounded border border-high/40 bg-high/5 px-4 py-3 text-sm">
        <Icon name="alert" size={16} class="shrink-0 text-high" />
        <p class="text-muted-strong">
          This post is outdated. Read the replacement:
          <a href={post.data.supersededBy} class="font-semibold text-brand hover:underline">
            {post.data.supersededBy}
          </a>
        </p>
      </div>
    )}

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <div class="min-w-0">
        {!isGuide && !isSuperseded && (
          <div class="mb-8">
            <BriefingBox post={post} />
          </div>
        )}

        {isGuide && (
          <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-xl border border-eng/30 bg-eng/5 px-5 py-3.5">
            <span class="inline-flex items-center gap-2 font-mono text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-eng">
              <Icon name="book" size={13} /> Living guide
            </span>
            <span class="text-xs text-muted-strong">Last reviewed {formatDate(modified)}</span>
            {post.data.updated && post.data.updated > post.data.date && (
              <span class="text-xs text-muted">
                Originally published {formatDate(post.data.date)}
              </span>
            )}
          </div>
        )}

        {headings.length >= 4 && <Toc headings={headings} variant="mobile" />}

        <div class="prose-signal" data-article-body>
          <slot />
        </div>

        {post.data.sources.length > 0 && (
          <section class="mt-12" aria-labelledby="sources-title" data-pagefind-ignore>
            <h2 id="sources-title" class="eyebrow mb-3">
              Sources
            </h2>
            <ol class="sources-list">
              {post.data.sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    class="inline-flex items-baseline gap-1 text-muted-strong underline decoration-line-strong underline-offset-4 hover:text-brand"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <span>{source.title}</span>
                    <Icon name="arrowUpRight" size={11} class="shrink-0 opacity-70" />
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )}

        {post.data.updates.length > 0 && (
          <section class="mt-10" aria-labelledby="updates-title" data-pagefind-ignore>
            <h2 id="updates-title" class="eyebrow mb-3">
              Story timeline
            </h2>
            <ol class="timeline">
              {post.data.updates.map((update) => (
                <li>
                  <time
                    datetime={isoDate(update.date)}
                    class="font-label text-[0.75rem] font-semibold text-brand"
                  >
                    {formatDate(update.date)}
                  </time>
                  <p class="mt-0.5">{update.note}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        <div
          class="mt-10 flex flex-wrap items-center gap-2 border-t border-line pt-5"
          data-pagefind-ignore
        >
          <span class="eyebrow mr-1">Tags</span>
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag">
              {tag}
            </a>
          ))}
        </div>

        <ArticleNav newer={newer} older={older} section={section.key} />
        <RelatedPosts posts={related} />
        <Comments />
      </div>

      <aside class="hidden lg:block" aria-label="Article tools" data-pagefind-ignore>
        <div class="sticky top-24 space-y-6">
          <Toc headings={headings} />
          <div class="sidebar-panel !p-4">
            <p class="panel-title !mb-3 !pb-2.5">Details</p>
            <dl class="space-y-2 font-mono text-[0.75rem]">
              <div class="flex justify-between gap-2">
                <dt class="text-muted">Published</dt>
                <dd class="text-muted-strong">
                  <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                </dd>
              </div>
              {post.data.updated && (
                <div class="flex justify-between gap-2">
                  <dt class="text-muted">Updated</dt>
                  <dd class="text-muted-strong">
                    <time datetime={isoDate(post.data.updated)}>
                      {formatDate(post.data.updated)}
                    </time>
                  </dd>
                </div>
              )}
              <div class="flex justify-between gap-2">
                <dt class="text-muted">Reading time</dt>
                <dd class="text-muted-strong">{minutes} min</dd>
              </div>
              {post.data.impact && (
                <div class="flex justify-between gap-2">
                  <dt class="text-muted">Impact</dt>
                  <dd class="text-muted-strong">{displayFormat(post.data.impact)}</dd>
                </div>
              )}
            </dl>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
