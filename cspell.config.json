{
  "version": "0.2",
  "language": "en-US",
  "files": ["src/content/**/*.md"],
  "ignorePaths": ["node_modules/**", "dist/**"],
  "ignoreRegExpList": [
    "/```[\\s\\S]*?```/g",
    "/`[^`]*`/g",
    "/<[^>]+>/g",
    "/https?:\\/\\/[^\\s)\"'>]+/g",
    "/\\bCVE-\\d{4}-\\d+\\b/g",
    "/\\bGHSA-[a-z0-9-]+\\b/gi",
    "/\\b[0-9a-f]{7,40}\\b/gi"
  ],
  "words": [
    "Astro",
    "CISA",
    "Checkmarx",
    "CloudSEK",
    "Deployers",
    "GPAI",
    "Giscus",
    "Knora",
    "MALFEX",
    "Pagefind",
    "SAIF",
    "SafeDep",
    "Sigstore",
    "Technica",
    "bursty",
    "chatbots",
    "exfil",
    "exfiltration",
    "frontmatter",
    "imgdecode",
    "llmops",
    "lockfiles",
    "metacharacters",
    "mxdriver",
    "shellcode",
    "spoofable",
    "subprocessors",
    "tldriver",
    "tlxbnhd",
    "typosquat",
    "unreviewed"
  ]
}
