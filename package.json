{
  "name": "oxelan-signal",
  "version": "1.0.0",
  "private": true,
  "description": "Oxelan Signal \u2014 what changed in AI and security, why it matters, and what to do.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/validate-content.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-content.mjs",
    "spell": "cspell --no-progress --no-summary \"src/content/**/*.md\"",
    "check:images": "node scripts/check-images.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "node scripts/verify-build.mjs",
    "ci": "npm run check && npm run test && npm run validate && npm run spell && npm run check:images && npm run build && npm run check:links && npm run verify",
    "new": "node scripts/new-post.mjs",
    "digest": "node scripts/digest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "pagefind": "1.5.2",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "cspell": "^9.8.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
